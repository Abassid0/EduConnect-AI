# ── App ──
APP_ENV=development          # development | production
# Must be 32+ random chars in production or the app refuses to start.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-secret
API_VERSION=v1
DEBUG=true                   # false in production
PORT=8000                    # Railway injects this automatically

# ── JWT lifetimes (optional — these are the defaults) ──
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── School term & fee policy ──
# UPDATE CURRENT_TERM AT THE START OF EACH TERM. New registrations are
# billed for whichever term is set here.
CURRENT_TERM=first           # first | second | third
CURRENT_ACADEMIC_YEAR=       # e.g. 2025/2026 — blank derives it from today
INVOICE_DUE_DAYS=21          # days a parent has to settle a term invoice
# School-wide instalment offer. Every parent is offered the same split.
INSTALLMENT_COUNT=3          # 2–24, or 1 to disable instalments entirely
INSTALLMENT_FREQUENCY=monthly  # weekly | biweekly | monthly

# ── CORS (comma-separated, required in production) ──
CORS_ORIGINS=                # e.g. https://admin.educonnect.ai,https://educonnect.ai

# ── Database (Supabase) ──
# Local Docker:
DATABASE_URL=postgresql+asyncpg://educonnect:educonnect@db:5432/educonnect
# Supabase pooler (production):
# DATABASE_URL=postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ── Redis ──
# Local Docker:
REDIS_URL=redis://redis:6379/0
# Railway Redis (production):
# REDIS_URL=redis://default:[PASSWORD]@[HOST]:6379

# ── WhatsApp Cloud API ──
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_BUSINESS_ACCOUNT_ID=your_ba_id
WA_ACCESS_TOKEN=your_permanent_token
WA_VERIFY_TOKEN=your_webhook_verify_token
WA_APP_SECRET=your_app_secret_for_signature_verification
WA_API_VERSION=v21.0         # optional — this is the default

# ── Paystack ──
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_CALLBACK_URL=https://your-app.up.railway.app/api/v1/payments/callback

# ── AWS S3 (receipt storage) ──
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_S3_BUCKET=educonnect-ai-receipts
AWS_REGION=eu-west-1

# ── Claude AI ──
ANTHROPIC_API_KEY=sk-ant-xxx

# ── Telegram (testing channel) ──
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=           # Telegram group/chat ID for admin notifications

# ── Admin Notifications ──
WHATSAPP_ADMIN_PHONE=             # WhatsApp number for admin alerts (future)
ADMIN_DASHBOARD_URL=              # e.g. https://educonnect-ai.pages.dev
