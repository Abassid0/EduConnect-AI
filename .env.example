# ── App ──
APP_ENV=development          # development | production
SECRET_KEY=change-me-to-a-random-secret
API_VERSION=v1
DEBUG=true                   # false in production
PORT=8000                    # Railway injects this automatically

# ── CORS (comma-separated, required in production) ──
CORS_ORIGINS=                # e.g. https://admin.edpassare.ng,https://edpassare.ng

# ── Database (Supabase) ──
# Local Docker:
DATABASE_URL=postgresql+asyncpg://edpassare:edpassare@db:5432/edpassare
# Supabase pooler (production):
# DATABASE_URL=postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ── Redis ──
# Local Docker:
REDIS_URL=redis://redis:6379/0
# Railway Redis (production):
# REDIS_URL=redis://default:[PASSWORD]@[HOST]:6379

# ── WhatsApp Cloud API ──
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_BUSINESS_ACCOUNT_ID=your_ba_id
WA_ACCESS_TOKEN=your_permanent_token
WA_VERIFY_TOKEN=your_webhook_verify_token
WA_APP_SECRET=your_app_secret_for_signature_verification

# ── Paystack ──
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_CALLBACK_URL=https://edpassare.ng/payment/callback

# ── AWS S3 (receipt storage) ──
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_S3_BUCKET=edpassare-receipts
AWS_REGION=eu-west-1

# ── Claude AI ──
ANTHROPIC_API_KEY=sk-ant-xxx

# ── Telegram (testing channel) ──
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=
